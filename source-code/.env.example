NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@crm-cluster.69oc5ah.mongodb.net/crm_sales_db?retryWrites=true&w=majority&appName=crm-cluster

# JWT secrets - replace with secure random values
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Token expiration
ACCESS_TOKEN_TTL=2h

# Frontend origin allowed by CORS
CORS_ORIGIN=https://crm-backend-assignment-pvqh.onrender.com

# Used only by: npm run seed:admin
SEED_ADMIN_NAME=CRM Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=1234567890
SEED_ADMIN_PASSWORD=replace-with-a-strong-password